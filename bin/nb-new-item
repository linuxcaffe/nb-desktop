#!/usr/bin/env bash
# nb-new-item — create a shop item (one or more images) via nb-web's
# /api/item/new. Designed for preciousfinds-style workflows: select one or
# more images in a file manager's icon view (real thumbnails, real
# multi-select — the whole point of routing through here instead of a
# browser's bare file-open dialog) and right-click "Add New Item".
#
# The first selected image becomes the item's primary image; any further
# selected images are supplemental, auto-suffixed by the server
# (code.ext, code-1.ext, code-2.ext, ...). Code (filename/accounting
# reference) and title (descriptive text) are distinct fields -- both
# prompted for, matching the item specialty header's own "+ New" flow in
# nb-web, which this script mirrors (same /api/item/new call, same
# one-item-per-N-images semantics).
#
# Calling conventions (auto-detected):
#   Caja script:   nb-new-item                             (paths in $CAJA_SCRIPT_SELECTED_FILE_PATHS, newline-separated, one or more)
#   Terminal:      nb-new-item /path/a.jpg /path/b.jpg ...  (one or more plain path arguments)
#   Nemo action:   nb-new-item <file:///path/to/image>      (single URI argument)
#
# Requires: zenity, curl, jq. Requires nb-web running and reachable at
# NB_WEB_URL (default http://127.0.0.1:5001 -- override for a remote
# install, e.g. a second real user's own machine: export
# NB_WEB_URL=http://10.0.0.19:5001, or the Tailscale address).
#
# Tags: best-effort, optional. If python3 + GExiv2 are available (already
# true wherever Pix is installed -- same library it uses internally, no
# extra package needed), reads each selected file's embedded IPTC/XMP
# Keywords and pre-fills the new item's tags: field. Only works if Pix's
# "store metadata in files" setting is on; silently yields nothing otherwise
# -- this never blocks item creation.
#
# Auth: a real per-user session-cookie login (username/password, prompted
# via zenity on first use), NOT the shared local .api_token -- that token
# is bound to one fixed account, so every script invocation using it would
# be attributed to that one account regardless of who's actually at the
# keyboard. This is the same login flow a browser uses; the cookie jar is
# cached locally and reused until it stops working, then re-prompted.
# Found+fixed 2026-07-16 while setting up a second real (non-dev) user.

LOG="/tmp/nb-new-item.log"
exec > >(tee -a "$LOG") 2>&1
echo "--- nb-new-item $(date) ---"

NB_WEB_URL="${NB_WEB_URL:-http://127.0.0.1:5001}"
STATE_DIR="${NB_NEW_ITEM_STATE_DIR:-$HOME/.local/share/nb-new-item}"
COOKIE_JAR="$STATE_DIR/session.cookies"
LAST_USER_FILE="$STATE_DIR/last-username"
mkdir -p "$STATE_DIR"

# ── Session (login once, reuse; re-login on expiry) ─────────────────────────
_session_valid() {
    [[ -f "$COOKIE_JAR" ]] || return 1
    local code
    code=$(curl -sS -o /dev/null -w '%{http_code}' -b "$COOKIE_JAR" "$NB_WEB_URL/api/notebooks" 2>>"$LOG")
    [[ "$code" == "200" ]]
}

_login() {
    local default_user
    default_user="$([[ -f "$LAST_USER_FILE" ]] && cat "$LAST_USER_FILE" || echo "")"

    local creds
    if ! creds=$(zenity --forms \
            --title="nb-web login" \
            --text="Sign in to <b>$NB_WEB_URL</b>" \
            --add-entry="Username" \
            --add-password="Password" \
            --separator="|" 2>/dev/null); then
        return 1
    fi
    local user pass
    user="$(cut -d'|' -f1 <<< "$creds")"
    pass="$(cut -d'|' -f2 <<< "$creds")"
    [[ -z "$user" ]] && user="$default_user"
    [[ -z "$user" || -z "$pass" ]] && return 1

    : > "$COOKIE_JAR"
    local code
    code=$(curl -sS -o /dev/null -w '%{http_code}' -c "$COOKIE_JAR" -X POST "$NB_WEB_URL/login" \
               --data-urlencode "username=$user" --data-urlencode "password=$pass" 2>>"$LOG")
    if [[ "$code" != "302" ]]; then
        zenity --error --title="nb new item" --text="Login failed (check username/password)." 2>/dev/null
        return 1
    fi
    echo "$user" > "$LAST_USER_FILE"
    return 0
}

if ! _session_valid; then
    echo "no valid session, logging in"
    if ! _login; then
        exit 1
    fi
fi

# ── Resolve file path(s) ────────────────────────────────────────────────────
decode_uri() {
    local p="${1#file://}"
    printf '%b\n' "${p//%/\\x}"
}

FILES=()
if [[ $# -gt 0 ]]; then
    for arg in "$@"; do
        FILES+=("$(decode_uri "$arg")")
    done
    echo "source: arguments (${#FILES[@]})"
else
    SELECTED="${CAJA_SCRIPT_SELECTED_FILE_PATHS:-${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}}"
    if [[ -z "$SELECTED" ]]; then
        zenity --error --title="nb new item" \
               --text="No file provided.\n\nRun from a file manager or pass path(s) as arguments." \
               2>/dev/null
        exit 1
    fi
    while IFS= read -r line; do
        [[ -n "$line" ]] && FILES+=("$line")
    done <<< "$SELECTED"
    echo "source: env var (${#FILES[@]})"
fi

for f in "${FILES[@]}"; do
    if [[ ! -f "$f" ]]; then
        zenity --error --title="nb new item" --text="File not found:\n$f" 2>/dev/null
        exit 1
    fi
done
echo "files: ${FILES[*]}"

# ── Tags: best-effort read of embedded IPTC/XMP Keywords off each selected
# file (Pix writes tags there when "store metadata in files" is enabled --
# GExiv2, not exiftool, since that's the library Pix itself already uses and
# needs no extra install). Silently yields nothing if GExiv2 is unavailable
# or the files just have no tags -- this is a bonus, never a hard dependency.
TAGS_CSV=""
if command -v python3 &>/dev/null; then
    TAGS_CSV="$(python3 - "${FILES[@]}" <<'PYEOF' 2>>"$LOG"
import sys
try:
    import gi
    gi.require_version('GExiv2', '0.10')
    from gi.repository import GExiv2
except Exception:
    sys.exit(0)

tags = []
for path in sys.argv[1:]:
    try:
        md = GExiv2.Metadata()
        md.open_path(path)
        for key in ('Iptc.Application2.Keywords', 'Xmp.dc.subject', 'Xmp.iptc.Keywords'):
            for t in (md.try_get_tag_multiple(key) or []):
                t = t.strip()
                if t and t not in tags:
                    tags.append(t)
    except Exception:
        pass
print(','.join(tags))
PYEOF
)"
fi
echo "tags: $TAGS_CSV"

FIRST_BASENAME="$(basename "${FILES[0]}")"
if [[ "$FIRST_BASENAME" == *.* && "${FIRST_BASENAME:0:1}" != "." ]]; then
    STEM="${FIRST_BASENAME%.*}"
else
    STEM="$FIRST_BASENAME"
fi

# ── Step 1: Notebook -- via the API (not the local nb CLI: this script may
# be running on a machine that has no local notebooks at all, e.g. a second
# real user's own laptop; the API also naturally respects their notebooks:
# scope, so a restricted account only ever sees what they're allowed to) ───
mapfile -t NB_NAMES < <(
    curl -sS -b "$COOKIE_JAR" "$NB_WEB_URL/api/notebooks" 2>>"$LOG" | jq -r '.notebooks[]' 2>>"$LOG"
)
echo "notebooks: ${NB_NAMES[*]}"
if [[ ${#NB_NAMES[@]} -eq 0 ]]; then
    zenity --error --title="nb new item" --text="No notebooks available for this account." 2>/dev/null
    exit 1
fi

IMG_LABEL="${FIRST_BASENAME}$([[ ${#FILES[@]} -gt 1 ]] && echo " (+$((${#FILES[@]}-1)) more)")"

if ! NOTEBOOK=$(zenity --list \
        --title="New Item  (1/2)" \
        --text="Image: <b>$IMG_LABEL</b>\n\nChoose a notebook:" \
        --column="Notebook" \
        "${NB_NAMES[@]}" \
        --height=380 --width=380 2>/dev/null); then
    echo "cancelled at notebook picker"
    exit 0
fi
[[ -z "$NOTEBOOK" ]] && { echo "no notebook selected"; exit 0; }
echo "notebook: $NOTEBOOK"

# ── Step 2: Code + Title ─────────────────────────────────────────────────────
if ! RESULT=$(zenity --forms \
        --title="New Item  (2/2)" \
        --text="Notebook: <b>$NOTEBOOK</b>    Image: <b>$IMG_LABEL</b>\n\nCode is the filename / accounting reference (e.g. ABC123).\nTitle is the descriptive text." \
        --add-entry="Code  (default: $STEM)" \
        --add-entry="Title" \
        --separator="|" \
        --width=460 2>/dev/null); then
    echo "cancelled at code/title form"
    exit 0
fi

CODE="$(cut -d'|' -f1 <<< "$RESULT")"
TITLE="$(cut -d'|' -f2 <<< "$RESULT")"
[[ -z "$CODE" ]] && CODE="$STEM"

if [[ -z "$TITLE" ]]; then
    zenity --error --title="nb new item" --text="Title is required." 2>/dev/null
    exit 1
fi
echo "code: $CODE  title: $TITLE"

# ── POST to /api/item/new ────────────────────────────────────────────────────
CURL_ARGS=(-sS -X POST "$NB_WEB_URL/api/item/new"
           -b "$COOKIE_JAR"
           -F "notebook=$NOTEBOOK" -F "code=$CODE" -F "title=$TITLE")
[[ -n "$TAGS_CSV" ]] && CURL_ARGS+=(-F "tags=$TAGS_CSV")
for f in "${FILES[@]}"; do
    CURL_ARGS+=(-F "files=@$f")
done

if ! RESPONSE="$(curl "${CURL_ARGS[@]}" 2>>"$LOG")"; then
    zenity --error --title="nb new item" \
           --text="Could not reach nb-web at <tt>$NB_WEB_URL</tt>.\n\nIs it running? Check /tmp/nb-new-item.log for details." \
           --width=420 2>/dev/null
    exit 1
fi
echo "response: $RESPONSE"

SUCCESS="$(jq -r '.success // false' <<< "$RESPONSE" 2>/dev/null)"
if [[ "$SUCCESS" != "true" ]]; then
    ERR="$(jq -r '.error // "unknown error"' <<< "$RESPONSE" 2>/dev/null)"
    zenity --error --title="nb new item" --text="Failed:\n$ERR" --width=420 2>/dev/null
    echo "failed: $ERR"
    exit 1
fi

ITEM="$(jq -r '.item' <<< "$RESPONSE")"
N_IMAGES="$(jq -r '.images | length' <<< "$RESPONSE")"
SELECTOR="$(jq -r '.selector' <<< "$RESPONSE")"
FAILURES="$(jq -r '.failures | length' <<< "$RESPONSE")"

MSG="✓ <b>items/$ITEM.md</b>\n✓ $N_IMAGES image(s)\n\nSaved to notebook: <b>$NOTEBOOK</b>"
[[ -n "$TAGS_CSV" ]] && MSG+="\n✓ tags: ${TAGS_CSV//,/, }"
[[ "$FAILURES" != "0" ]] && MSG+="\n\n⚠ $FAILURES image(s) failed — see $LOG"
MSG+="\n\nOpen nb-web to complete the item details."

zenity --info --title="nb new item — done" --text="$MSG" --width=400 2>/dev/null || true
echo "done: $SELECTOR"
