#!/usr/bin/env bash
# nb-new-item — import an image and create a matching item note in an nb notebook.
#
# Designed for preciousfinds-style workflows: image and item note share the same
# base filename (e.g. ABC001.jpg → images/ABC001.jpg + items/ABC001.md).
#
# Calling conventions (auto-detected):
#   Caja script:   nb-new-item                           (paths in $CAJA_SCRIPT_SELECTED_FILE_PATHS)
#   Terminal:      nb-new-item /path/to/image            (plain path argument)
#   Nemo action:   nb-new-item <file:///path/to/image>   (URI argument)

LOG="/tmp/nb-new-item.log"
exec > >(tee -a "$LOG") 2>&1
echo "--- nb-new-item $(date) ---"

NB_DIR="${NB_DIR:-$HOME/.nb}"
NB_BIN="$(command -v nb 2>/dev/null || echo "$HOME/.local/bin/nb")"

# ── Resolve file path ─────────────────────────────────────────────────────────
decode_uri() {
    local p="${1#file://}"
    printf '%b\n' "${p//%/\\x}"
}

if [[ -n "${1:-}" ]]; then
    FILE="$(decode_uri "$1")"
    echo "source: argument"
else
    SELECTED="${CAJA_SCRIPT_SELECTED_FILE_PATHS:-${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}}"
    if [[ -z "$SELECTED" ]]; then
        zenity --error --title="nb new item" \
               --text="No file provided.\n\nRun from a file manager or pass a path as an argument." \
               2>/dev/null
        exit 1
    fi
    FILE="$(head -1 <<< "$SELECTED")"
    echo "source: env var"
fi

echo "file: $FILE"

if [[ ! -f "$FILE" ]]; then
    zenity --error --title="nb new item" --text="File not found:\n$FILE" 2>/dev/null
    exit 1
fi

BASENAME="$(basename "$FILE")"
if [[ "$BASENAME" == *.* && "${BASENAME:0:1}" != "." ]]; then
    EXT=".${BASENAME##*.}"
    STEM="${BASENAME%.*}"
else
    EXT=""
    STEM="$BASENAME"
fi
echo "basename: $BASENAME  stem: $STEM  ext: ${EXT:-(none)}"

# ── Step 1: Notebook ──────────────────────────────────────────────────────────
mapfile -t NB_NAMES < <(
    "$NB_BIN" notebooks --no-color 2>/dev/null \
    | sed 's/[[:space:]].*//' \
    | grep -v '^$' || true
)

echo "notebooks: ${NB_NAMES[*]}"

if ! NOTEBOOK=$(zenity --list \
        --title="New Item  (1/2)" \
        --text="Image: <b>$BASENAME</b>\n\nChoose a notebook:" \
        --column="Notebook" \
        "${NB_NAMES[@]}" \
        --height=380 --width=380 2>/dev/null); then
    echo "cancelled at notebook picker"
    exit 0
fi
[[ -z "$NOTEBOOK" ]] && { echo "no notebook selected"; exit 0; }
echo "notebook: $NOTEBOOK"

# ── Step 2: Base name ─────────────────────────────────────────────────────────
if ! RESULT=$(zenity --forms \
        --title="New Item  (2/2)" \
        --text="Notebook: <b>$NOTEBOOK</b>    Image: <b>$BASENAME</b>\n\nThe base name is used for both the image file and the item note.\nLeave blank to keep <b>$STEM</b>." \
        --add-entry="Base name  (default: $STEM)" \
        --separator="|" \
        --width=460 2>/dev/null); then
    echo "cancelled at base name form"
    exit 0
fi

BASE_IN="$(cut -d'|' -f1 <<< "$RESULT")"
[[ -z "$BASE_IN" ]] && BASE_IN="$STEM"
# Strip extension if user typed one
[[ -n "$EXT" && "$BASE_IN" == *.* ]] && BASE_IN="${BASE_IN%.*}"

IMG_FILENAME="${BASE_IN}${EXT}"
ITEM_FILENAME="${BASE_IN}.md"
TODAY="$(date +%Y-%m-%d)"

echo "image: $IMG_FILENAME  item: $ITEM_FILENAME  date: $TODAY"

# ── Copy image → images/ ──────────────────────────────────────────────────────
IMG_DIR="$NB_DIR/$NOTEBOOK/images"
mkdir -p "$IMG_DIR"
cp "$FILE" "$IMG_DIR/$IMG_FILENAME"

IMG_INDEX="$IMG_DIR/.index"
touch "$IMG_INDEX"
grep -qxF "$IMG_FILENAME" "$IMG_INDEX" || echo "$IMG_FILENAME" >> "$IMG_INDEX"
echo "image copied to $IMG_DIR/$IMG_FILENAME"

# ── Create item note from template ────────────────────────────────────────────
ITEMS_DIR="$NB_DIR/$NOTEBOOK/items"
TEMPLATE="$ITEMS_DIR/.templates/item.md"
ITEM_PATH="$ITEMS_DIR/$ITEM_FILENAME"

mkdir -p "$ITEMS_DIR"

if [[ -f "$ITEM_PATH" ]]; then
    zenity --error --title="nb new item" \
           --text="Item note already exists:\n<b>items/$ITEM_FILENAME</b>\n\nChoose a different base name." \
           2>/dev/null
    echo "aborted: item already exists"
    exit 1
fi

if [[ -f "$TEMPLATE" ]]; then
    sed \
        -e "s|{{title}}|$BASE_IN|g" \
        -e "s|{{date}}|$TODAY|g" \
        -e "s|^image:.*|image: $IMG_FILENAME|" \
        "$TEMPLATE" > "$ITEM_PATH"
    echo "item created from template"
else
    # Fallback: minimal frontmatter matching the standard schema
    cat > "$ITEM_PATH" <<EOF
---
title: $BASE_IN
date: $TODAY
status: available
category:
caption:
description:
price:
qtty:
image: $IMG_FILENAME
condition:
platform:
listing:
tags: []
---
EOF
    echo "item created with fallback frontmatter (no template found at $TEMPLATE)"
fi

# ── Update items .index ───────────────────────────────────────────────────────
ITEM_INDEX="$ITEMS_DIR/.index"
touch "$ITEM_INDEX"
grep -qxF "$ITEM_FILENAME" "$ITEM_INDEX" || echo "$ITEM_FILENAME" >> "$ITEM_INDEX"
echo "item indexed"

# ── Git commit ────────────────────────────────────────────────────────────────
git -C "$NB_DIR/$NOTEBOOK" add -- \
    "images/$IMG_FILENAME" "images/.index" \
    "items/$ITEM_FILENAME" "items/.index" 2>/dev/null || true
git -C "$NB_DIR/$NOTEBOOK" commit \
    -m "[nb] New item: $BASE_IN" 2>/dev/null || true
echo "git committed"

# ── Done ─────────────────────────────────────────────────────────────────────
zenity --info \
    --title="nb new item — done" \
    --text="✓ <b>images/$IMG_FILENAME</b>\n✓ <b>items/$ITEM_FILENAME</b>\n\nSaved to notebook: <b>$NOTEBOOK</b>\n\nOpen nb-web to complete the item details." \
    --width=400 2>/dev/null || true

echo "done"
