#!/usr/bin/env bash
# nb-import — import a file into an nb notebook via a two-step zenity dialog.
#
# Calling conventions (auto-detected):
#   Nemo action:   nb-import <file:///path/to/file>   (URI argument)
#   Caja script:   nb-import                           (paths in $CAJA_SCRIPT_SELECTED_FILE_PATHS)
#   Terminal:      nb-import /path/to/file             (plain path argument)

LOG="/tmp/nb-import.log"
exec > >(tee -a "$LOG") 2>&1
echo "--- nb-import $(date) ---"

NB_DIR="${NB_DIR:-$HOME/.nb}"
NB_BIN="$(command -v nb 2>/dev/null || echo "$HOME/.local/bin/nb")"

# ── Resolve file path ─────────────────────────────────────────────────────────
decode_uri() {
    local p="${1#file://}"
    printf '%b\n' "${p//%/\\x}"
}

if [[ -n "${1:-}" ]]; then
    FILE="$(decode_uri "$1")"
    echo "source: argument URI/path"
else
    SELECTED="${CAJA_SCRIPT_SELECTED_FILE_PATHS:-${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}}"
    if [[ -z "$SELECTED" ]]; then
        zenity --error --title="nb import" \
               --text="No file provided.\n\nRun from a file manager or pass a path as an argument." \
               2>/dev/null
        exit 1
    fi
    FILE="$(head -1 <<< "$SELECTED")"
    echo "source: env var CAJA/NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
fi

echo "file: $FILE"

if [[ ! -f "$FILE" ]]; then
    zenity --error --title="nb import" --text="File not found:\n$FILE" 2>/dev/null
    exit 1
fi

BASENAME="$(basename "$FILE")"

# ── Extension handling ────────────────────────────────────────────────────────
# EXT includes the dot (e.g. ".jpg"), or is empty if no extension.
if [[ "$BASENAME" == *.* && "${BASENAME:0:1}" != "." ]]; then
    EXT=".${BASENAME##*.}"
    STEM="${BASENAME%.*}"
else
    EXT=""
    STEM="$BASENAME"
fi
echo "basename: $BASENAME  stem: $STEM  ext: ${EXT:-(none)}"

# ── Binary file guard ─────────────────────────────────────────────────────────
MIME_TYPE="$(file --mime-type -b "$FILE" 2>/dev/null || echo "unknown")"
echo "mime: $MIME_TYPE"

_mime_ok() {
    case "$1" in
        text/*|image/*|audio/*|video/*) return 0 ;;
        application/pdf|application/json|application/xml|\
        application/javascript|application/zip|application/gzip|\
        application/x-tar|application/x-bzip2|application/x-xz|\
        application/x-7z-compressed|application/epub*|\
        application/vnd.*) return 0 ;;
        *) return 1 ;;
    esac
}

if ! _mime_ok "$MIME_TYPE"; then
    if ! zenity --question \
            --title="nb import — unusual file type" \
            --text="<b>$BASENAME</b>\n\nDetected type: <tt>$MIME_TYPE</tt>\n\nThis file may not display well in a notebook.\nImport anyway?" \
            --ok-label="Import anyway" \
            --cancel-label="Cancel" \
            --width=420 2>/dev/null; then
        echo "cancelled: binary guard"
        exit 0
    fi
    echo "proceeding despite unusual mime type"
fi

# ── Step 1: Notebook ──────────────────────────────────────────────────────────
mapfile -t NB_NAMES < <(
    "$NB_BIN" notebooks --no-color 2>/dev/null \
    | sed 's/[[:space:]].*//' \
    | grep -v '^$' || true
)

echo "notebooks: ${NB_NAMES[*]}"

if ! NOTEBOOK=$(zenity --list \
        --title="Import to nb  (1/2)" \
        --text="Importing: <b>$BASENAME</b>\n\nChoose a notebook:" \
        --column="Notebook" \
        "${NB_NAMES[@]}" \
        --height=380 --width=380 2>/dev/null); then
    echo "cancelled at notebook picker"
    exit 0
fi

[[ -z "$NOTEBOOK" ]] && { echo "no notebook selected"; exit 0; }
echo "notebook: $NOTEBOOK"

# ── Step 2: Folder + details ──────────────────────────────────────────────────
mapfile -t SUBFOLDERS < <(
    find "$NB_DIR/$NOTEBOOK" -mindepth 1 -maxdepth 2 \
        -type d ! -name '.*' ! -path '*/.git*' 2>/dev/null \
    | sed "s|$NB_DIR/$NOTEBOOK/||" \
    | sort || true
)

FOLDER_VALUES="(root)"
for sub in "${SUBFOLDERS[@]}"; do
    FOLDER_VALUES+="|$sub"
done
echo "folder values: $FOLDER_VALUES"

EXT_HINT="${EXT:+  · <i>${EXT}</i> appended automatically}"

# Use | as separator — works reliably with cut (single ASCII byte).
if ! RESULT=$(zenity --forms \
        --title="Import to nb  (2/2)" \
        --text="Notebook: <b>$NOTEBOOK</b>    File: <b>$BASENAME</b>\n\nLeave Title / Filename blank to use defaults." \
        --add-combo="Folder" --combo-values="$FOLDER_VALUES" \
        --add-entry="Filename (no extension needed${EXT_HINT})  default: $STEM" \
        --separator="|" \
        --width=460 2>/dev/null); then
    echo "cancelled at details form"
    exit 0
fi

[[ -z "$RESULT" ]] && { echo "empty result"; exit 0; }
echo "raw result: $RESULT"

FOLDER_RAW="$(cut -d'|' -f1 <<< "$RESULT")"
FILENAME_IN="$(cut -d'|' -f2 <<< "$RESULT")"

echo "folder_raw: $FOLDER_RAW  filename_in: $FILENAME_IN"

[[ "$FOLDER_RAW" == "(root)" ]] && FOLDER="" || FOLDER="$FOLDER_RAW"
[[ -z "$FILENAME_IN" ]] && FILENAME_IN="$STEM"

# Strip any extension the user typed and enforce the original.
[[ -n "$EXT" && "$FILENAME_IN" == *.* ]] && FILENAME_IN="${FILENAME_IN%.*}"
FILENAME_IN="${FILENAME_IN}${EXT}"

echo "resolved — folder: ${FOLDER:-(root)}  title: $TITLE_IN  filename: $FILENAME_IN"

# ── Copy + index ──────────────────────────────────────────────────────────────
TARGET_DIR="$NB_DIR/$NOTEBOOK${FOLDER:+/$FOLDER}"
echo "target dir: $TARGET_DIR"
mkdir -p "$TARGET_DIR"
cp "$FILE" "$TARGET_DIR/$FILENAME_IN"
echo "copied file"

INDEX="$TARGET_DIR/.index"
touch "$INDEX"
grep -qxF "$FILENAME_IN" "$INDEX" || echo "$FILENAME_IN" >> "$INDEX"
echo "index updated"

# ── Git commit ────────────────────────────────────────────────────────────────
REL_PATH="${FOLDER:+$FOLDER/}$FILENAME_IN"
git -C "$NB_DIR/$NOTEBOOK" add -- "$REL_PATH" "${FOLDER:+$FOLDER/}.index" 2>/dev/null || true
git -C "$NB_DIR/$NOTEBOOK" commit -m "[nb] Import: $REL_PATH" 2>/dev/null || true
echo "git done"

# ── Done ──────────────────────────────────────────────────────────────────────
zenity --info \
    --title="nb import" \
    --text="✓ <b>$FILENAME_IN</b>\nimported to <b>$NOTEBOOK${FOLDER:+/$FOLDER}</b>" \
    --width=360 2>/dev/null || true

echo "done"
